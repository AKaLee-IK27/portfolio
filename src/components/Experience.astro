---
import SectionHeading from "./SectionHeading.astro";
import Tag from "./Tag.astro";
import { experience } from "../data/experience";
---

<section id="experience" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 md:py-24">
  <SectionHeading index="02" title="Experience" />

  <ol class="relative space-y-12">
    <span
      aria-hidden="true"
      class="absolute left-[5px] top-3 bottom-3 w-px bg-mint-deep"></span>

    {
      experience.map((role) => (
        <li class="reveal relative pl-9">
          <span
            aria-hidden="true"
            class={`absolute left-0 top-[7px] h-2.5 w-2.5 rounded-full ring-4 ring-paper ${role.current ? "bg-leaf" : "bg-mint-deep"}`}
          />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-display text-xl font-semibold text-ink">
              {role.company}
              {role.current && (
                <span class="ml-2 align-middle rounded-full bg-leaf/15 px-2 py-0.5 text-xs font-semibold tracking-wide text-pine">
                  Present
                </span>
              )}
            </h3>
            <span class="text-sm tabular-nums text-moss">{role.period}</span>
          </div>
          <p class="mt-0.5 font-medium text-pine">
            {role.title} <span class="text-moss">&middot; {role.location}</span>
          </p>

          <ul class="mt-3 space-y-2">
            {role.highlights.map((h) => (
              <li class="flex gap-2.5 leading-relaxed text-ink/85">
                <span aria-hidden="true" class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-leaf" />
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <ul class="mt-4 flex flex-wrap gap-2">
            {role.tags.map((t) => <Tag>{t}</Tag>)}
          </ul>
        </li>
      ))
    }
  </ol>
</section>

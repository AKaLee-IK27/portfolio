---
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";
---

<section id="contact" class="scroll-mt-20 bg-pine text-paper">
  <div class="mx-auto max-w-5xl px-6 py-20 text-center md:py-28">
    <p class="flex items-center justify-center gap-3 text-sm font-semibold uppercase tracking-[0.2em] text-mint">
      <span aria-hidden="true" class="inline-block h-px w-8 bg-mint/60"></span>
      05 — Contact
      <span aria-hidden="true" class="inline-block h-px w-8 bg-mint/60"></span>
    </p>

    <h2 class="reveal mx-auto mt-5 max-w-2xl font-display text-4xl font-semibold leading-tight text-white md:text-5xl">
      Let's build something calm.
    </h2>
    <p class="reveal mx-auto mt-4 max-w-xl text-lg text-mint/90">
      Open to mobile and AI-focused engineering roles. The quickest way to reach
      me is email.
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-pine transition-colors hover:bg-mint"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        {site.email}
      </a>
      <a
        href={site.resume}
        class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-white/10"
      >
        Download résumé
      </a>
    </div>

    <div class="reveal mt-8 flex justify-center">
      <SocialLinks tone="onDark" />
    </div>
  </div>
</section>

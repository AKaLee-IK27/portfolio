---
interface Props {
  lang: "en" | "vi";
  href?: string;
}

const { lang, href } = Astro.props;
const isEn = lang === "en";
const label = isEn ? "Tiếng Việt" : "English";
---

{href && (
  <div class="inline-flex items-center gap-2 text-sm">
    <span class={isEn ? "text-pine font-medium" : "text-moss"}>EN</span>
    <span class="text-mint-deep">·</span>
    <a
      href={href}
      class={`font-medium transition-colors hover:text-pine ${!isEn ? "text-pine" : "text-moss"}`}
    >
      {label}
    </a>
  </div>
)}

---
import { site } from "../data/site";
---

<footer class="border-t border-mint-deep">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-8 text-sm text-moss"
  >
    <p>© 2026 {site.name}</p>
    <p class="flex items-center gap-2">
      <span>Built with Astro</span>
      <span aria-hidden="true" class="text-mint-deep">·</span>
      <span>Deployed on Vercel</span>
      <a href="#top" class="ml-2 font-medium text-pine hover:underline">Back to top ↑</a>
    </p>
  </div>
</footer>

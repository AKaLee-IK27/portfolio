---
interface Props {
  index: string;
  title: string;
}
const { index, title }: Props = Astro.props;
---

<div class="reveal mb-10 flex items-baseline gap-4">
  <span class="font-display text-base font-semibold text-pine">{index}</span>
  <h2 class="font-display text-3xl font-semibold text-ink md:text-4xl">{title}</h2>
  <span aria-hidden="true" class="ml-2 h-px flex-1 translate-y-[-0.4rem] bg-mint-deep"></span>
</div>

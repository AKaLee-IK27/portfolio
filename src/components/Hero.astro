---
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";
---

<section id="top" class="relative overflow-hidden">
  <!-- quiet mint wash, top-right, purely atmospheric -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 -top-40 h-[28rem] w-[28rem] rounded-full bg-mint blur-3xl opacity-60"
  >
  </div>

  <div class="relative mx-auto max-w-5xl px-6 pb-20 pt-24 md:pb-28 md:pt-32">
    <p class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.2em] text-pine">
      <span class="inline-block h-px w-8 bg-leaf"></span>
      {site.role}
    </p>

    <h1 class="mt-5 font-display text-5xl font-semibold leading-[1.02] text-ink sm:text-6xl md:text-7xl">
      Anh Khoi Le
    </h1>

    <p class="mt-7 max-w-2xl text-xl leading-relaxed text-ink/90 md:text-2xl">
      I build mobile and web products in <a
        href="#skills"
        class="font-medium text-pine underline decoration-leaf/50 decoration-2 underline-offset-4 transition-colors hover:decoration-leaf"
        >Flutter</a
      >, and ship them faster with <a
        href="#projects"
        class="font-medium text-pine underline decoration-leaf/50 decoration-2 underline-offset-4 transition-colors hover:decoration-leaf"
        >AI coding agents</a
      >.
    </p>

    <p class="mt-4 text-moss">
      Currently at Vietnam Silicon &middot; {site.location}
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-full bg-pine px-5 py-2.5 text-sm font-semibold text-white shadow-card transition-colors hover:bg-[#22481d]"
      >
        View work
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a
        href={site.resume}
        class="inline-flex items-center gap-2 rounded-full border border-pine/25 px-5 py-2.5 text-sm font-semibold text-pine transition-colors hover:bg-mint"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
        Download résumé
      </a>
      <span class="mx-1 hidden h-6 w-px bg-mint-deep sm:block"></span>
      <SocialLinks />
    </div>
  </div>
</section>

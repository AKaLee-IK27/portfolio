---
import { site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";

// Illustrative agent session for the hero terminal: a visual flourish that
// dramatizes the tagline (an AI agent does the work, human review keeps the
// quality bar). Decorative only — the card is aria-hidden and makes no metric
// claim; the same point is stated as text in the tagline below.
const session = [
  { kind: "cmd", glyph: "$", text: 'claude "refactor auth module"' },
  { kind: "run", glyph: "▸", text: "editing 3 files" },
  { kind: "ok", glyph: "✓", text: "refactored · unit tests pass" },
  { kind: "ok", glyph: "✓", text: "self-review: clean" },
  { kind: "note", glyph: "→", text: "queued for human review" },
];
---

<section id="top" class="relative overflow-hidden">
  <!-- quiet mint wash, top-right, purely atmospheric -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 -top-40 h-[28rem] w-[28rem] rounded-full bg-mint blur-3xl opacity-60"
  >
  </div>

  <div class="relative mx-auto max-w-5xl px-6 pb-20 pt-24 md:pb-28 md:pt-32">
    <div class="grid items-center gap-12 md:grid-cols-[1.1fr_0.9fr] md:gap-10">
      <!-- left: identity -->
      <div>
        <p class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.2em] text-pine">
          <span class="inline-block h-px w-8 bg-leaf"></span>
          {site.role}
        </p>

        <h1 class="mt-5 font-display text-5xl font-semibold leading-[1.02] text-ink sm:text-6xl md:text-6xl lg:text-7xl">
          Anh Khoi Le
        </h1>

        <p class="mt-7 max-w-2xl text-xl leading-relaxed text-ink/90 md:text-2xl">
          I build mobile and web products in <a
            href="#skills"
            class="font-medium text-pine underline decoration-leaf/50 decoration-2 underline-offset-4 transition-colors hover:decoration-leaf"
            >Flutter</a
          >, and ship them faster with <a
            href="#projects"
            class="font-medium text-pine underline decoration-leaf/50 decoration-2 underline-offset-4 transition-colors hover:decoration-leaf"
            >AI coding agents</a
          >.
        </p>

        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-moss">
          <span
            class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-leaf/40 bg-leaf/10 px-2.5 py-0.5 text-xs font-semibold text-pine"
          >
            <span class="relative inline-flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf opacity-70"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-leaf"></span>
            </span>
            Open to work
          </span>
          <span>{site.location}</span>
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-full bg-pine px-5 py-2.5 text-sm font-semibold text-white shadow-card transition-colors hover:bg-[#22481d]"
          >
            View work
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a
            href={site.resume}
            class="inline-flex items-center gap-2 rounded-full border border-pine/25 px-5 py-2.5 text-sm font-semibold text-pine transition-colors hover:bg-mint"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
            Download résumé
          </a>
          <span class="mx-1 hidden h-6 w-px bg-mint-deep sm:block"></span>
          <SocialLinks />
        </div>
      </div>

      <!-- right: agentic terminal (decorative flourish reinforcing the tagline) -->
      <div class="term-wrap md:justify-self-end" aria-hidden="true">
        <div class="term">
          <div class="term-bar">
            <span class="term-dot"></span>
            <span class="term-dot"></span>
            <span class="term-dot"></span>
            <span class="term-label">agent&nbsp;session</span>
          </div>
          <div class="term-body">
            {
              session.map((l, i) => (
                <span class={`term-line term-${l.kind}`}>
                  <span class="term-glyph">{l.glyph}</span>
                  <span class="term-text">{l.text}</span>
                  {i === session.length - 1 && <span class="term-cursor" />}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .term {
    width: 100%;
    max-width: 30rem;
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid rgba(234, 243, 228, 0.09);
    background: #12211a; /* a touch deeper than --color-ink for the "screen" */
    box-shadow:
      0 1px 2px rgba(22, 36, 27, 0.06),
      0 22px 48px -24px rgba(22, 36, 27, 0.5);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(234, 243, 228, 0.07);
  }
  .term-dot {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 9999px;
    background: #3a5a44;
  }
  .term-dot:nth-child(1) { background: #4e9f3d; }
  .term-dot:nth-child(2) { background: #6f8f64; }
  .term-dot:nth-child(3) { background: #355040; }
  .term-label {
    margin-left: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #8a9a80;
  }
  .term-body {
    padding: 0.95rem 1.05rem 1.15rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: #dfeed7;
  }
  .term-line {
    display: block;
    transition: opacity 0.25s ease;
  }
  .term-line.term-pending {
    opacity: 0;
  }
  .term-glyph {
    display: inline-block;
    width: 1.15em;
    color: #7bc25f;
  }
  .term-cmd .term-text { color: #eaf3e4; }
  .term-run,
  .term-run .term-glyph { color: #8aa07f; }
  .term-ok .term-glyph { color: #7bc25f; }
  .term-ok .term-text { color: #cfe6c2; }
  .term-note,
  .term-note .term-glyph { color: #9bb091; }
  .term-cursor {
    display: inline-block;
    width: 0.5em;
    height: 1.02em;
    margin-left: 0.12em;
    vertical-align: -0.16em;
    background: #7bc25f;
    animation: term-blink 1.05s steps(1) infinite;
  }
  @keyframes term-blink {
    50% { opacity: 0; }
  }
</style>

<script>
  // Progressive enhancement: type the agent session once when it scrolls into
  // view. No JS or reduced-motion -> the full session is already in the DOM.
  const term = document.querySelector<HTMLElement>(".term");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (term && !reduce) {
    const lines = Array.from(term.querySelectorAll<HTMLElement>(".term-line"));
    const cursor = term.querySelector<HTMLElement>(".term-cursor");
    const texts = lines.map((l) => l.querySelector(".term-text")?.textContent ?? "");

    // Clear and hide every line until it is typed.
    lines.forEach((l) => {
      const t = l.querySelector(".term-text");
      if (t) t.textContent = "";
      l.classList.add("term-pending");
    });

    const typeLine = (i: number) =>
      new Promise<void>((resolve) => {
        const line = lines[i];
        const t = line.querySelector(".term-text");
        line.classList.remove("term-pending");
        if (cursor) line.appendChild(cursor); // keep the cursor at the active line
        const full = texts[i];
        let c = 0;
        const step = () => {
          c++;
          if (t) t.textContent = full.slice(0, c);
          if (cursor) line.appendChild(cursor);
          if (c < full.length) {
            window.setTimeout(step, 16 + Math.random() * 24);
          } else {
            window.setTimeout(resolve, 240);
          }
        };
        if (full.length === 0) resolve();
        else step();
      });

    const run = async () => {
      for (let i = 0; i < lines.length; i++) await typeLine(i);
    };

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              obs.disconnect();
              run();
            }
          }
        },
        { threshold: 0.3 },
      );
      io.observe(term);
    } else {
      run();
    }
  }
</script>

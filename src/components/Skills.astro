---
import SectionHeading from "./SectionHeading.astro";
import Tag from "./Tag.astro";
import { skills } from "../data/skills";
---

<section id="skills" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-16 md:py-24">
  <SectionHeading index="04" title="Skills" />

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((group) => (
        <div class="reveal">
          <h3 class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-pine">
            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-leaf" />
            {group.label}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {/* First item is the group's lead skill -> filled accent chip. */}
            {group.items.map((item, i) => (
              <Tag lead={i === 0}>{item}</Tag>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

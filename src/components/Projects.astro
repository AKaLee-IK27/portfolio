---
import SectionHeading from "./SectionHeading.astro";
import Tag from "./Tag.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="scroll-mt-20 bg-mint/45 py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading index="03" title="Projects" />

    <p class="reveal -mt-4 mb-10 max-w-2xl text-moss">
      Open-source work, built in the open. Each links to its repository on GitHub.
    </p>

    <div class="grid gap-5 sm:grid-cols-2">
      {
        projects.map((p, i) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`reveal group flex flex-col rounded-2xl border border-mint-deep bg-paper p-6 shadow-card transition duration-300 hover:-translate-y-1 hover:border-leaf ${i === 0 ? "sm:col-span-2" : ""}`}
          >
            {i === 0 && (
              <span class="mb-2 inline-flex w-fit items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-pine">
                <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-leaf" />
                Featured
              </span>
            )}
            <div class="flex items-start justify-between gap-3">
              <h3
                class={`font-display font-semibold text-ink transition-colors group-hover:text-pine ${i === 0 ? "text-2xl" : "text-xl"}`}
              >
                {p.name}
              </h3>
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 shrink-0 text-moss transition duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-pine"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </div>

            <p
              class={`mt-3 flex-1 leading-relaxed text-ink/80 ${i === 0 ? "max-w-2xl" : ""}`}
            >
              {p.blurb}
            </p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <Tag>{t}</Tag>
              ))}
            </ul>
          </a>
        ))
      }
    </div>

    <p class="reveal mt-8 text-sm text-moss">
      More on
      <a
        href="https://github.com/AKaLee-IK27"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-pine underline decoration-leaf/40 underline-offset-2 hover:decoration-leaf"
        >github.com/AKaLee-IK27</a
      >.
    </p>
  </div>
</section>

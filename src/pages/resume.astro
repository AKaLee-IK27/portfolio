---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { experience } from "../data/experience";
import { skills } from "../data/skills";
import { education, achievements, certifications, languages } from "../data/about";
import { projects } from "../data/projects";

const summary =
  "Software engineer building mobile and web products in Flutter, most recently at Vietnam Silicon. I run AI coding agents in production to ship faster without giving up code quality, holding the line with rigorous review. B.Eng in Software Engineering, UIT (VNU-HCM).";
---

<Base title={`${site.name} — Résumé`}>
  <main class="resume">
    <header class="r-head">
      <h1>{site.name}</h1>
      <p class="r-role">{site.role} · Mobile Developer</p>
      <p class="r-contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>·</span>
        <a href={Astro.site?.href}>Portfolio</a>
        <span>·</span>
        <a href={site.links.github}>GitHub</a>
        <span>·</span>
        <a href={site.links.linkedin}>LinkedIn</a>
        <span>·</span>
        <span>{site.location}</span>
      </p>
    </header>

    <section>
      <h2>Summary</h2>
      <p class="r-summary">{summary}</p>
    </section>

    <section>
      <h2>Experience</h2>
      {
        experience.map((role) => (
          <div class="r-role-block">
            <div class="r-role-line">
              <span class="r-company">{role.company}</span>
              <span class="r-period">{role.period}</span>
            </div>
            <p class="r-title">
              {role.title} · {role.location}
            </p>
            <ul>
              {role.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <p class="r-tags">Tech: {role.tags.join(" · ")}</p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <ul class="r-skills">
        {
          skills.map((g) => (
            <li>
              <strong>{g.label}:</strong> {g.items.join(", ")}
            </li>
          ))
        }
      </ul>
    </section>

    <div class="r-grid">
      <section>
        <h2>Projects</h2>
        <ul class="r-projects">
          {projects.slice(0, 3).map((p) => (
            <li>
              <div class="r-proj-head">
                <strong>{p.name}</strong>
                <span class="r-proj-tags">{p.tags.join(" · ")}</span>
              </div>
              {p.blurb}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        {
          education.map((e) => (
            <p class="r-edu">
              <strong>{e.school}</strong>
              <br />
              <span>{e.detail} · {e.period}</span>
            </p>
          ))
        }
        <h2 class="r-mt">Recognition</h2>
        <ul class="r-mini">
          {achievements.map((a) => <li>{a.title}{a.detail ? `, ${a.detail}` : ""} ({a.year})</li>)}
          {certifications.map((c) => <li>{c.title} ({c.year})</li>)}
        </ul>
        <h2 class="r-mt">Languages</h2>
        <p class="r-langs">{languages.map((l) => `${l.name} (${l.level})`).join(" · ")}</p>
      </section>
    </div>
  </main>

  <style is:global>
    @page {
      size: A4;
      margin: 14mm 15mm;
    }
    body {
      background: #ffffff;
    }
    .resume {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 28px 48px;
      color: #16241b;
      font-size: 10.6pt;
      line-height: 1.5;
    }
    .resume a {
      color: #2c5f2d;
      text-decoration: none;
    }
    .r-head {
      border-bottom: 2px solid #4e9f3d;
      padding-bottom: 12px;
      margin-bottom: 16px;
    }
    .r-head h1 {
      font-size: 26pt;
      font-weight: 600;
      letter-spacing: -0.01em;
      margin: 0;
      font-family: var(--font-display);
    }
    .r-role {
      color: #2c5f2d;
      font-weight: 600;
      margin: 2px 0 6px;
    }
    .r-contact {
      color: #5d6b58;
      font-size: 9.5pt;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    /* Section headers: uppercase label + hairline divider for clear structure */
    .resume h2 {
      font-size: 10pt;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2c5f2d;
      font-weight: 700;
      margin: 16px 0 9px;
      padding-bottom: 4px;
      border-bottom: 1px solid #cfe0c3;
      font-family: var(--font-display);
    }
    .r-summary {
      margin: 0;
    }
    /* Experience: a soft left rule groups each role block */
    .r-role-block {
      margin-bottom: 11px;
      padding-left: 12px;
      border-left: 2px solid #dcebd2;
      break-inside: avoid;
    }
    .r-role-line {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .r-company {
      font-weight: 600;
      font-size: 11.5pt;
    }
    .r-period {
      color: #5d6b58;
      font-size: 9.5pt;
      white-space: nowrap;
    }
    .r-title {
      color: #2c5f2d;
      font-weight: 500;
      margin: 1px 0 4px;
      font-size: 10pt;
    }
    .resume ul {
      margin: 0;
      padding-left: 16px;
    }
    .resume li {
      margin-bottom: 2px;
    }
    .r-tags {
      color: #5d6b58;
      font-size: 9pt;
      margin: 3px 0 0;
      padding-left: 16px;
    }
    /* Skills: full-width compact band under Experience */
    .r-skills {
      padding-left: 0;
    }
    .r-skills li {
      margin-bottom: 4px;
      list-style: none;
    }
    /* Lower area: two balanced columns (Projects / background) */
    .r-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 26px;
      margin-top: 2px;
      align-items: start;
    }
    .r-projects {
      padding-left: 0;
      list-style: none;
      font-size: 9.8pt;
    }
    .r-projects li {
      margin-bottom: 7px;
    }
    .r-proj-head {
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 1px;
    }
    .r-proj-head strong {
      font-size: 10.2pt;
    }
    .r-proj-tags {
      color: #5d6b58;
      font-size: 8.6pt;
    }
    .r-edu {
      margin: 0 0 8px;
    }
    .r-edu span {
      color: #5d6b58;
      font-size: 9.5pt;
    }
    .r-mt {
      margin-top: 14px;
    }
    .r-mini {
      font-size: 9.8pt;
    }
    .r-langs {
      margin: 0;
      font-size: 9.8pt;
    }
    /* keep the document calm in print; the brand color stays in accents only */
    @media print {
      .resume {
        padding: 0;
        max-width: none;
      }
    }
  </style>
</Base>

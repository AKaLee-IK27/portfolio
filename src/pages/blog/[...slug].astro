---
import { render, type CollectionEntry, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import LanguageToggle from "../../components/LanguageToggle.astro";

export async function getStaticPaths() {
  const postsEn = await getCollection("blog");
  const postsVi = await getCollection("blog-vi");

  return [
    ...postsEn.map((post) => ({
      params: { slug: `en/${post.id}` },
      props: { post, lang: "en" as const },
    })),
    ...postsVi.map((post) => ({
      params: { slug: `vi/${post.id}` },
      props: { post, lang: "vi" as const },
    })),
  ];
}

const { post, lang } = Astro.props as {
  post: CollectionEntry<"blog"> | CollectionEntry<"blog-vi">;
  lang: "en" | "vi";
};
const { Content } = await render(post);

const isEn = lang === "en";
const otherLang = isEn ? "vi" : "en";
const title = `${post.data.title} — Blog — Anh Khoi Le`;
const description = post.data.description;


const formatDate = (d: Date) =>
  isEn
    ? d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
    : d.toLocaleDateString("vi-VN", { year: "numeric", month: "long", day: "numeric" });
---

<Base {title} {description}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[60] focus:rounded-md focus:bg-pine focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
  >
    Skip to content
  </a>
  <Nav />

  <main id="main" class="py-16 md:py-24">
    <article class="mx-auto max-w-[65ch] px-6">
      <header class="reveal mb-10">
        <div class="mb-4">
          <LanguageToggle {lang} />
        </div>
        <a
          href="/blog"
          class="mb-6 inline-block text-sm font-medium text-moss hover:text-pine transition-colors"
        >
          {isEn ? "← Back to Blog" : "← Quay lại Blog"}
        </a>
        <h1 class="text-3xl md:text-4xl font-display font-semibold text-ink leading-tight">
          {post.data.title}
        </h1>
        <p class="mt-3 text-moss leading-relaxed">{post.data.description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-moss">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <span>· Updated {formatDate(post.data.updatedDate)}</span>
          )}
        </div>
      </header>

      <div class="reveal prose">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</Base>

<script>
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const revealIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            revealIO.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
    );
    reveals.forEach((el) => revealIO.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add("is-visible"));
  }
</script>

---
import "@fontsource-variable/fraunces/wght.css";
import "@fontsource/be-vietnam-pro/400.css";
import "@fontsource/be-vietnam-pro/500.css";
import "@fontsource/be-vietnam-pro/600.css";
import "@fontsource/be-vietnam-pro/700.css";
import "../styles/global.css";
import { site } from "../data/site";

// Above-the-fold faces preloaded so the real font swaps in sooner (the hero H1
// uses Fraunces; body copy uses Be Vietnam Pro 400). `?url` yields the hashed
// build asset so the preload never goes stale; `crossorigin` is required — font
// fetches are anonymous-CORS, and omitting it makes the browser fetch twice.
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import bvpLatin from "@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = `${site.name}: ${site.tagline} Based in ${site.location}.`,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const ogImage = Astro.site ? new URL("/og.png", Astro.site).href : "/og.png";

const personLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: Astro.site?.href,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ho Chi Minh City",
    addressCountry: "VN",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Information Technology, VNU-HCM",
  },
  sameAs: [site.links.github, site.links.linkedin],
});
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bvpLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#4e9f3d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Reveal JS is opt-in: drop the no-js guard the moment JS runs. -->
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
    {
      Astro.url.pathname === "/" && (
        <script type="application/ld+json" is:inline set:html={personLd} />
      )
    }
  </head>
  <body>
    {
      /* Progress bar on scrolling pages only; the résumé is a standalone document. */
      !Astro.url.pathname.startsWith("/resume") && (
        <div id="scroll-progress" aria-hidden="true" />
      )
    }
    <slot />
    <script>
      // Slim scroll-progress bar; harmless without JS (stays at 0 / hidden).
      const bar = document.getElementById("scroll-progress");
      if (bar) {
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update, { passive: true });
      }
    </script>
  </body>
</html>
